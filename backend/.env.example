PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./data/ml.db
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Gmail que envía los códigos (contraseña de aplicación: https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opcional: correo que recibe los avisos de pedidos (por defecto, GMAIL_USER)
# NOTIFICAR_A=
# Opcional: "consola" para ver los correos en la terminal sin enviarlos
# MAIL_MODO=gmail
# Número de WhatsApp de la tienda (sin + ni espacios)
WHATSAPP_NUMERO=595981000000

# Cuenta de administrador que crea "npm run seed"
ADMIN_EMAIL=
ADMIN_NOMBRE=Administración
ADMIN_PASSWORD=
